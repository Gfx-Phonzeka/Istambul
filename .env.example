# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Shared secret that lets the server send queued emails (must match private.config 'email_dispatch_secret')
EMAIL_DISPATCH_SECRET=

# Optional: transactional email through Resend (https://resend.com). Without it, emails are
# kept in the admin "Email log" with status "not configured".
RESEND_API_KEY=
EMAIL_FROM="Istanbul 2027 Portal <portal@your-domain.com>"

# Optional: automatic English → Turkish translation in the backoffice.
# DeepL (free plan, 500,000 characters/month: https://www.deepl.com/pro-api) is used first when set;
# otherwise Claude (https://console.anthropic.com → API keys).
DEEPL_API_KEY=
ANTHROPIC_API_KEY=
